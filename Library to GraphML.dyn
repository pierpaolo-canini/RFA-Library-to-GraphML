      ],
      "Replication": "Auto",
      "Description": "Queries the document properties.\r\nWorks also with familyDocument"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nfrom Autodesk.Revit.DB import FilteredElementCollector, ElementClassFilter, FamilySymbol, Family\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nfrom Revit.Elements import Element\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\nfamily_document = DocumentManager.Instance.CurrentDBDocument  # Use the current document as fallback\r\n\r\n# Collect families in document\r\nfiltered_elements = FilteredElementCollector(family_document) \\\r\n    .WherePasses(ElementClassFilter(Family)) \\\r\n    .ToElements()\r\n\r\ndynamo_elements = [element.ToDSType(True) for element in filtered_elements]\r\n\r\n# Output\r\nOUT = dynamo_elements\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "6558718e6f4c4e719d7cab5f62414e2f",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "3651bb7970234e0ba4842bfac0eed27e",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "077c913f3dec400e87e6f41d92f5f657",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
