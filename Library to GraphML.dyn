    {
      "ConcreteType": "Dynamo.Graph.Nodes.CustomNodes.Function, DynamoCore",
      "FunctionSignature": "9266cc47-e982-46fc-9fd4-59bd7fb19a53",
      "FunctionType": "Graph",
      "Id": "3280ee0c6683496a88e1f5a05d067b57",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "7b2a0359755a4f4eb26ee388855a9e64",
          "Name": "element",
          "Description": "var[]..[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "86d8e03b6d41442ba75a529a76361c6d",
          "Name": "name",
          "Description": "return value",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Auto",
      "Description": "Gets an element's name. Unlike the OOTB node, this node should work for *all* Revit elements that have names and will also return the localized names of system parameters, parameter groups, display unit types, parameter types, unit symbol types, unit types and ForgeTypeIds."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import os\r\nimport xml.etree.ElementTree as ET\r\nimport re\r\n\r\ndef get_or_create_family_map(path, mapFilename):\r\n    file_path = os.path.join(path, mapFilename)\r\n    \r\n    if not os.path.isfile(file_path):\r\n        root = ET.Element('graphml') \r\n        keys = [\r\n            {\"attr.name\": \"FileSize\", \"attr.type\": \"double\", \"for\": \"node\", \"id\": \"FileSize\"},\r\n            {\"attr.name\": \"FamilyName\", \"attr.type\": \"string\", \"for\": \"node\", \"id\": \"FamilyName\"},\r\n            {\"attr.name\": \"IsShared\", \"attr.type\": \"boolean\", \"for\": \"node\", \"id\": \"IsShared\"},\r\n            {\"attr.name\": \"Category\", \"attr.type\": \"string\", \"for\": \"node\", \"id\": \"Category\"},\r\n            {\"attr.name\": \"Directory\", \"attr.type\": \"string\", \"for\": \"node\", \"id\": \"Directory\"}\r\n        ]\r\n        for key in keys:\r\n            ET.SubElement(root, 'key', key)\r\n        \r\n        graph = ET.SubElement(root, 'graph', edgedefault=\"undirected\")\r\n        tree = ET.ElementTree(root)\r\n    else:\r\n        tree = ET.parse(file_path)\r\n        root = tree.getroot()\r\n    return tree, root\r\n\r\ndef check_xml_element_with_xpath(root, xpath, property_name, property_value):\r\n    for elem in root.findall(xpath):\r\n        if elem.attrib.get(property_name) == property_value:\r\n            return True\r\n    return False\r\n\r\ndef check_nested_xml_element_with_xpath(root, parent_xpath, parent_property, parent_value, child_xpath, child_property, child_value):\r\n    for parent in root.findall(parent_xpath):\r\n        if parent.attrib.get(parent_property) == parent_value:\r\n            for child in parent.findall(child_xpath):\r\n                if child.attrib.get(child_property) == child_value:\r\n                    return True\r\n    return False\r\n\r\ndef create_xml_element_with_xpath(root, xpath, element_name, property_name, property_value):\r\n    path_parts = xpath.strip('/').split('/')\r\n    current_element = root\r\n    for part in path_parts:\r\n        next_element = current_element.find(part)\r\n        if next_element is None:\r\n            next_element = ET.SubElement(current_element, part)\r\n        current_element = next_element\r\n    new_element = ET.SubElement(current_element, element_name)\r\n    new_element.set(property_name, property_value)\r\n    return root\r\n\r\ndef create_xml_element_by_id(root, parent_element_tag, parent_id, element_name, properties, text_value=None):\r\n    parent_element = None\r\n    for elem in root.findall(\".//\"+parent_element_tag+\"[@id='\"+parent_id+\"']\"):\r\n        parent_element = elem\r\n        break\r\n    \r\n    if parent_element is not None:\r\n        new_element = ET.SubElement(parent_element, element_name)\r\n        \r\n        for key, value in properties.items():\r\n            new_element.set(key, value)\r\n        \r\n        if text_value:\r\n            new_element.text = text_value\r\n        \r\n        return root\r\n    else:\r\n        print(f\"Element with id '{parent_id}' not found.\")\r\n        return root   \r\n\r\ndef add_properties_to_element_by_id(root, element_id, id_attribute, properties):\r\n    for elem in root.iter():\r\n        if elem.attrib.get(id_attribute) == element_id:\r\n            elem.attrib.update(properties)\r\n            break\r\n    return root\r\n\r\n#inputs\r\nscript_path = IN[0]\r\nfamily_data = IN[1]\r\n\r\n#main variables\r\nmap_filename = \"FamilyMap.graphml\"\r\nmap_path = os.path.join(script_path, map_filename)\r\nnested_families = family_data[\"NestedFamilies\"]\r\nself_node_id = family_data[\"FamilyName\"]\r\n\r\ntree, root = get_or_create_family_map(script_path, map_filename)\r\nroot_graphml = root\r\ngraph_element = root.find(\"graph\")\r\n\r\n#graphML logic\r\n# first let's  create nested families nodes if they don't exist yet\r\n\r\nfor nf in nested_families:\r\n    if not check_xml_element_with_xpath(root, \".//node\", \"id\", nf):\r\n        new_node = ET.SubElement(graph_element, \"node\", id=nf)\r\n\r\n#then let's do the same for the current doc family, if exists let's populate the data\r\nnodeExists = check_xml_element_with_xpath(root, \".//node\", \"id\", self_node_id)\r\nif not nodeExists:\r\n    new_node = ET.SubElement(graph_element, \"node\", id=self_node_id)\r\n    for k in family_data.keys():\r\n        root = create_xml_element_by_id(root, \"node\", self_node_id, \"data\", {\"key\": k}, str(family_data[k]))\r\nelse:\r\n    for k in family_data.keys():\r\n        node_data_exists = check_nested_xml_element_with_xpath(root, \"./graphml/graph/node\", \"id\", self_node_id, \".//data\", \"key\", k)\r\n        if not node_data_exists:\r\n            root = create_xml_element_by_id(root, \"node\", self_node_id, \"data\", {\"key\": k}, str(family_data[k]))\r\n\r\n#now that we have all the nodes, let's create all the needed edges\r\nfor nf in nested_families:\r\n    edge_id = nf+\"_to_\"+self_node_id\r\n    new_edge =  ET.SubElement(graph_element, 'edge', id=edge_id)\r\n    root = add_properties_to_element_by_id(root, edge_id, \"id\", {\"source\": nf, \"target\":self_node_id})\r\n\r\n#let's convert everything to string (we'll write the xml with OOTB dynamo nodes)\r\nxml_string = ET.tostring(root, encoding=\"unicode\")\r\n\r\nOUT = [xml_string, map_path]",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "990914a261614d018f9f01096b003fe9",
      "NodeType": "PythonScriptNode",
      "Inputs": [
